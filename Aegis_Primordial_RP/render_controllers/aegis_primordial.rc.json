    "a": 0.4
   },
   "overlay_color": {
    "r": 0.25,
    "g": 0.95,
    "b": 1.0,
    "a": "v.glow_overlay"
   },
   "light_color_multiplier": "1.0 + v.glow * 0.6"
  }
 }
}